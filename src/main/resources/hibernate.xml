<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- Konfigurasi Hibernate mandiri. Saat dipakai lewat Spring, DataSource berasal dari applicationContext.xml. -->
        <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/valorant_joki?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=Asia/Jakarta&amp;characterEncoding=UTF-8</property>
        <property name="hibernate.connection.username">root</property>
        <property name="hibernate.connection.password">123</property>
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>
        <property name="hibernate.hbm2ddl.auto">none</property>

        <mapping class="model.User"/>
        <mapping class="model.Layanan"/>
    </session-factory>
</hibernate-configuration>
